# Supabase project URL and publishable (anon) key.
# Local: run `npx supabase start` and copy API_URL and PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only needed for scripts/import-ocm.ts. Never expose these to the browser.
SUPABASE_SECRET_KEY=
OCM_API_KEY=

# Optional. Public URL used in sign-in emails; defaults to the request host.
NEXT_PUBLIC_SITE_URL=
